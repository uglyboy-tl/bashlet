#!/usr/bin/env bash
# shellcheck disable=SC2034
# 测试运行器 - 运行bashlet项目的Bats测试

set -euo pipefail
SCRIPT_NAME="测试运行器"
VERSION="1.0.3"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
BATS_DIR="$(cd test/bats && pwd)"
BATS_EXEC="$BATS_DIR/bin/bats"

source "$PROJECT_ROOT/lib/std/import.sh"
import std/fs
import core/args

# 检查Bats是否可用
check_bats() {
	fs.file.exists "$BATS_EXEC" && return 0
	log.error "Bats测试框架未找到: $BATS_EXEC"
	log.info "请确保Bats已正确安装在 test/bats/ 目录"
	exit 1
}

# 构建Bats命令参数
build_bats_args() {
	local -a args=()

	# 设置默认参数
	args+=("--jobs" "$JOBS")

	# 格式选项
	if [[ $TAP_FORMAT == "true" ]]; then
		args+=("--tap")
	fi

	# 过滤选项
	if [[ -n $FILTER_PATTERN ]]; then
		args+=("--filter" "$FILTER_PATTERN")
	fi

	# 计数选项
	if [[ $COUNT_ONLY == "true" ]]; then
		args+=("--count")
	fi

	echo "${args[@]}"
}

# 运行测试
run_tests() {
	local test_path="$1"

	log.info "开始运行测试..."

	# 切到当前目录下的 test 目录（宿主项目的测试），并把 bats 加入 PATH
	cd test
	export PATH="$BATS_DIR/bin:$PATH"

	# 构建Bats命令
	local bats_args
	bats_args=$(build_bats_args)

	# 运行测试
	log.info "执行: bats $bats_args $test_path"

	local exit_code=0
	eval "bats $bats_args $test_path" || exit_code=$?
	if ((exit_code == 0)); then
		log.success "执行成功!"
	else
		log.error "测试失败，退出码: $exit_code"
	fi
	return $exit_code
}

# 获取当前目录 test 下的所有测试文件
list_test_files() {
	cd test
	find . -name "*.bats" -not -path "./bats/*" -not -path "./test_bats/*" -not -path "./test_helper/*" | sort
}

# 显示测试统计
show_test_stats() {
	local test_files
	test_files=$(list_test_files)

	if [[ -z $test_files ]]; then
		log.warn "没有找到测试文件"
		return
	fi

	local count
	count=$(echo "$test_files" | wc -l)

	log.info "找到 $count 个测试文件:"
	echo "$test_files" | while read -r file; do
		echo "  - $file"
	done
}

# 主函数
main() {
	args.init "运行 bashlet 项目的 Bats 测试"
	args.add_options "version" "v" "显示版本信息"
	args.add_options "filter" "f" "只运行匹配模式的测试" "STRING"
	args.add_options "jobs" "j" "并行运行测试 (默认: 1)" "NUM"
	args.add_options "tap" "t" "使用TAP格式输出"
	args.add_options "count" "c" "只计算测试数量"
	args.add_options "exclude" "x" "排除匹配路径的测试文件" "PATTERN"
	args.add_options "arg" "测试文件/模式" "可选：指定测试文件或目录(默认: 运行所有测试)"
	args.add_options "example" "" "# 运行所有测试"
	args.add_options "example" "test.bats" "# 运行单个测试文件"
	args.add_options "example" '-f "log"' '# 运行包含"log"的测试'
	args.add_options "example" "-j 4" "# 并行运行4个测试"
	args.add_options "example" "-v test/log.bats" "# 详细运行特定测试"
	args.add_options "notice" '测试应该在项目的 test/ 目录下运行'
	args.add_options "notice" '测试文件必须使用 .bats 扩展名'

	args.process "$@"
	args.has "-v" "--version" && usage.version && exit 0
	args.has "-c" "--count" && COUNT_ONLY="true" || COUNT_ONLY="false"
	args.has "-t" "--tap" && TAP_FORMAT="true" || TAP_FORMAT="false"
	FILTER_PATTERN=$(args.get "-f" "--filter" 2> /dev/null) || FILTER_PATTERN=""
	JOBS=$(args.get "-j" "--jobs" 2> /dev/null) || JOBS="1"
	EXCLUDE_PATTERN=$(args.get "-x" "--exclude" 2> /dev/null) || EXCLUDE_PATTERN=""
	declare -n main_args=$(args.args)
	[[ ${#main_args[@]} -ne 0 ]] && TEST_TARGET="${main_args[*]}" || TEST_TARGET="."

	# --exclude：仅在默认全量运行时生效，按路径过滤测试文件
	if [[ -n $EXCLUDE_PATTERN && $TEST_TARGET == "." ]]; then
		TEST_TARGET=$(list_test_files | grep -v "$EXCLUDE_PATTERN" | tr '\n' ' ')
	fi

	# 检查Bats
	check_bats

	# 运行测试
	run_tests "$TEST_TARGET"
}

# 入口点
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
	main "$@"
fi
