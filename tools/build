#!/usr/bin/env bash
# shellcheck disable=SC2034
# bashlet 脚本整合器：把入口脚本与其 import 的模块合并成单一可执行文件。
# 载荷约束：产物大小即脚本的运行时代价，因此依赖按需内联、可选用 shfmt 压缩。

set -euo pipefail
SCRIPT_NAME="脚本整合器"
VERSION="4.0.0"
LC_COLLATE=C
PROJECT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
source "$PROJECT_ROOT/lib/std/import.sh"
.env
import std/ansi
import std/system
import core/log
import core/args

# 确保颜色变量被定义（在非交互模式下 ansi.enable.color 不会执行）
ansi.disable.color

# 读取一个文件里的 import 目标：去掉行尾注释，支持一行多个模块
extract_imports() {
	local file="$1" line rest mod
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^[[:space:]]*import[[:space:]]+(.*)$ ]] || continue
		rest="${BASH_REMATCH[1]%%#*}"
		for mod in $rest; do
			printf '%s\n' "$mod"
		done
	done < "$file"
}

declare -A _BUILD_SEEN=()
declare -a _BUILD_ORDER=()

# 解析 import：入口脚本所在目录的 lib/ 优先（脚本私有模块），再回退框架 _LIB_DIR
_build_resolve() {
	local mod="$1"
	[[ -n ${_BUILD_LIB_DIR:-} && -f "$_BUILD_LIB_DIR/$mod.sh" ]] && {
		printf '%s' "$_BUILD_LIB_DIR/$mod.sh"
		return 0
	}
	[[ -f "$_LIB_DIR/$mod.sh" ]] && printf '%s' "$_LIB_DIR/$mod.sh"
}

# 深度优先后序收集：先内联依赖，再内联依赖它们的文件
_collect_deps() {
	local file="$1" mod resolved
	[[ -n ${_BUILD_SEEN[$file]:-} ]] && return 0
	_BUILD_SEEN[$file]=1
	while IFS= read -r mod; do
		[[ -z $mod ]] && continue
		resolved="$(_build_resolve "$mod")"
		[[ -n $resolved ]] || {
			log.error "无法解析 import: $mod（来自 ${file#"$PROJECT_ROOT"/}）"
			return 1
		}
		_collect_deps "$resolved" || return 1
	done < <(extract_imports "$file")
	_BUILD_ORDER+=("$file")
}

# 静态解析入口脚本的依赖（不执行目标脚本，避免 pass/config.load 等副作用）
# 输出：按内联顺序排列的文件绝对路径，入口文件在最后
analyze_dependencies() {
	_BUILD_SEEN=()
	_BUILD_ORDER=()
	_BUILD_LIB_DIR="$(cd "$(dirname "$1")" && pwd)/lib"
	[[ -d $_BUILD_LIB_DIR ]] || _BUILD_LIB_DIR=""
	_collect_deps "$1" || return 1
	printf '%s\n' "${_BUILD_ORDER[@]}"
}

# 剥离顶层指令行。只匹配行首无缩进的语句，避免误伤函数体里缩进的 source/import。
# .env 调用一律剥掉：keep_env=true 时由 build() 在模块内联之前统一插入一次（见那里的注释）。
strip_directives() {
	local file="$1" line
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line =~ ^\.env([[:space:]]|$) ]] && continue
		[[ $line =~ ^(#!|set[[:space:]]|SCRIPT_NAME=|source[[:space:]]|import[[:space:]]) ]] && continue
		printf '%s\n' "$line"
	done < "$file"
}

get_script_name() {
	sed -n 's/^SCRIPT_NAME="\(.*\)"/\1/p' "$1" | head -1
}

# 可选压缩：有 shfmt 就用 minify，没有则保持原样（产物可执行，只是体积偏大）
minify_output() {
	local out="$1"
	if system.command.exist shfmt; then
		shfmt -mn -w "$out"
	else
		log.warn "未找到 shfmt，跳过压缩（产物可执行，但体积偏大）"
	fi
}

report_size() {
	local out="$1" bytes
	bytes=$(stat -c%s "$out" 2> /dev/null || stat -f%z "$out" 2> /dev/null)
	if ((bytes >= 1024)); then
		log.success "完成! 大小: $((bytes / 1024))KB (${bytes} bytes)"
	else
		log.success "完成! 大小: ${bytes}B"
	fi
}

build() {
	log.info "开始构建..."
	local main_path="$MAIN_FILE"
	[[ $main_path == /* ]] || main_path="$PROJECT_ROOT/$MAIN_FILE"
	[[ -f $main_path ]] || {
		log.error "主文件不存在: $MAIN_FILE"
		return 1
	}
	log.info "分析依赖: $MAIN_FILE"

	local dep_list
	dep_list=$(analyze_dependencies "$main_path") || {
		log.error "依赖解析失败，中止构建"
		return 1
	}
	local -a deps=()
	mapfile -t deps <<< "$dep_list"
	[[ ${#deps[@]} -gt 0 ]] || {
		log.error "未解析到任何依赖"
		return 1
	}

	SCRIPT_NAME="$(get_script_name "$main_path")"
	[[ -n $SCRIPT_NAME ]] || SCRIPT_NAME="$(basename "${MAIN_FILE%.sh}")"
	[[ -n ${OUTPUT_FILE:-} ]] || OUTPUT_FILE="${OUTPUT_DIR:-$PROJECT_ROOT/build}/${SCRIPT_NAME,,}"
	mkdir -p "$(dirname "$OUTPUT_FILE")"

	# 入口脚本可用注释指令 `# build:keep-env` 选择保留 .env 加载
	local keep_env=false
	grep -qE '^#[[:space:]]*build:keep-env' "$main_path" && keep_env=true

	{
		echo '#!/usr/bin/env bash'
		echo 'set -euo pipefail'
		echo "SCRIPT_NAME=\"$SCRIPT_NAME\""
		echo
		if [[ $keep_env == true ]]; then
			declare -f .env
			echo
			# .env 必须插在模块内联之前：模块顶层会读环境（core/log 读 _LOG_LEVEL），
			# 而入口剩余部分在模块之后才输出 —— 放那里就等于没生效。
			echo '.env'
			echo
		fi
	} > "$OUTPUT_FILE"

	local file
	for file in "${deps[@]}"; do
		log.info "合并: ${file#"$PROJECT_ROOT"/}"
		strip_directives "$file" >> "$OUTPUT_FILE"
	done

	minify_output "$OUTPUT_FILE"
	chmod +x "$OUTPUT_FILE"
	report_size "$OUTPUT_FILE"
	log.info "最终文件: $OUTPUT_FILE"
}

main() {
	args.init "Shell 脚本打包工具"
	args.add_options "version" "v" "显示版本信息"
	args.add_options "arg" "脚本源文件" "待编译脚本的入口文件（默认为 main.sh）"
	args.add_options "output" "o" "输出文件" "STRING"
	args.process "$@"
	args.has "-v" "--version" && usage.version && exit 0
	declare -n args=$(args.args)
	[[ ${#args[@]} -gt 0 ]] && MAIN_FILE="${args[0]}" || MAIN_FILE="main.sh"
	OUTPUT_FILE=$(args.get "-o" "--output" 2> /dev/null) || OUTPUT_FILE=""
	build
}

if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
	main "$@"
fi
