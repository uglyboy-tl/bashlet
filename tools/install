#!/usr/bin/env bash
VERSION="0.4.1"

set -euo pipefail

CURRENT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUBMODULE_DIR="$(dirname "$CURRENT_PATH")"
SUBMODULE_NAME="$(basename "$SUBMODULE_DIR")"
PROJECT_ROOT="$(dirname "$SUBMODULE_DIR")"
LIB_DIR="$PROJECT_ROOT/lib"

source "$SUBMODULE_DIR/lib/std/import.sh"
import core/args

main() {
	args.init 构建开发环境
	args.add_options "version" "v" "显示版本信息"

	args.process "$@"
	args.has "-v" "--version" && usage.version && exit 0

	mkdir -p "$LIB_DIR"
	cd "$PROJECT_ROOT"
	[[ ! -d lib/core ]] && ln -rsfn "$SUBMODULE_NAME/lib/core" lib/
	[[ ! -d lib/std ]] && ln -rsfn "$SUBMODULE_NAME/lib/std" lib/
	[[ ! -d lib/ext ]] && ln -rsfn "$SUBMODULE_NAME/lib/ext" lib/
	[[ ! -f "main.sh" ]] && cp "$SUBMODULE_NAME/examples/main.sh" ./
	[[ ! -f "config.toml" ]] && touch config.toml
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
		main "$@"
fi
